[
  {
    "n": {
      "identity": 1347,
      "labels": [
        "风险名称"
      ],
      "properties": {
        "name": "主轴承损坏"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1347"
    }
  },
  {
    "n": {
      "identity": 1348,
      "labels": [
        "原因"
      ],
      "properties": {
        "name": "选型不当或荷载过大",
        "描述": "选用的主轴承型号无法满足实际地质条件下的载荷要求，或掘进中长期超负荷运转。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1348"
    }
  },
  {
    "n": {
      "identity": 1349,
      "labels": [
        "原因"
      ],
      "properties": {
        "name": "微动磨损",
        "描述": "在两个紧密接触面之间发生微小、高频的相对振动，导致表面材料逐渐磨损剥落。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1349"
    }
  },
  {
    "n": {
      "identity": 1350,
      "labels": [
        "原因"
      ],
      "properties": {
        "name": "异物进入",
        "描述": "由于密封失效，导致地下水、泥沙、石块等坚硬颗粒物进入轴承内部，造成滚道和滚动体的划伤或磨损。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1350"
    }
  },
  {
    "n": {
      "identity": 1351,
      "labels": [
        "原因"
      ],
      "properties": {
        "name": "接触疲劳",
        "描述": "在长期交变应力的作用下，轴承滚道或滚动体表面下产生微小裂纹，并逐渐扩展至表面形成麻点或剥落。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1351"
    }
  },
  {
    "n": {
      "identity": 1352,
      "labels": [
        "原因"
      ],
      "properties": {
        "name": "润滑失效",
        "描述": "润滑油脂因污染、氧化、耗尽或乳化而失去润滑性能，无法在金属表面间形成有效油膜。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1352"
    }
  },
  {
    "n": {
      "identity": 1353,
      "labels": [
        "原因"
      ],
      "properties": {
        "name": "主驱动轴承油脂量不足",
        "描述": "未能向上万个滚柱及时、足量地供给润滑油脂，导致轴承干摩擦或润滑不良。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1353"
    }
  },
  {
    "n": {
      "identity": 1354,
      "labels": [
        "原因"
      ],
      "properties": {
        "name": "水土压力过大",
        "描述": "掘进面的水土压力超过了密封系统的承受极限，不仅可能导致异物侵入，也会对主轴承产生巨大的附加荷载。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1354"
    }
  },
  {
    "n": {
      "identity": 1355,
      "labels": [
        "原因"
      ],
      "properties": {
        "name": "维护不当",
        "描述": "未按照规程进行定期的油脂加注、更换、密封检查和状态监测，导致隐患未能及时发现和处理。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1355"
    }
  },
  {
    "n": {
      "identity": 1356,
      "labels": [
        "原因"
      ],
      "properties": {
        "name": "电流通过轴承",
        "描述": "变频驱动等系统产生的电位差导致杂散电流穿过轴承，在滚道表面烧蚀出微小的凹坑，即电蚀现象。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1356"
    }
  },
  {
    "n": {
      "identity": 1357,
      "labels": [
        "原因"
      ],
      "properties": {
        "name": "严重损坏",
        "描述": "初期的微小损伤未能得到控制，持续发展累积，最终演变为断裂、卡死等不可逆的严重故障状态。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1357"
    }
  },
  {
    "n": {
      "identity": 1358,
      "labels": [
        "原因"
      ],
      "properties": {
        "name": "超使用寿命",
        "描述": "主轴承的实际工作时间或掘进里程已经达到了其设计的使用寿命上限，故障概率显著增加。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1358"
    }
  },
  {
    "n": {
      "identity": 1359,
      "labels": [
        "现象"
      ],
      "properties": {
        "name": "推进力异常",
        "描述": "主轴承损坏导致刀盘旋转阻力增大，进而使得整机推进所需的油缸总推力也出现异常波动或升高。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1359"
    }
  },
  {
    "n": {
      "identity": 1360,
      "labels": [
        "现象"
      ],
      "properties": {
        "name": "扭矩异常",
        "描述": "驱动刀盘旋转所需的扭矩值持续偏高、剧烈波动或突然增大。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1360"
    }
  },
  {
    "n": {
      "identity": 1361,
      "labels": [
        "现象"
      ],
      "properties": {
        "name": "推进速度下降",
        "描述": "由于旋转受阻和扭矩异常，为保护设备，操作手不得不降低掘进速度。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1361"
    }
  },
  {
    "n": {
      "identity": 1362,
      "labels": [
        "现象"
      ],
      "properties": {
        "name": "刀盘转速不稳定或受阻",
        "描述": "刀盘在旋转时出现速度不均匀、晃动、卡顿甚至无法转动的情况。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1362"
    }
  },
  {
    "n": {
      "identity": 1363,
      "labels": [
        "现象"
      ],
      "properties": {
        "name": "轴承温度异常升高",
        "描述": "轴承内部因摩擦加剧而产生大量热量，通过温度传感器可以监测到其温度超过了警戒值。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1363"
    }
  },
  {
    "n": {
      "identity": 1364,
      "labels": [
        "现象"
      ],
      "properties": {
        "name": "振动水平和振动信号特征异常",
        "描述": "通过振动监测系统，发现主驱动系统的振动幅值异常增大，或在频谱分析中出现了轴承故障的特征频率。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1364"
    }
  },
  {
    "n": {
      "identity": 1365,
      "labels": [
        "现象"
      ],
      "properties": {
        "name": "主驱动系统发出异常噪音",
        "描述": "能听到从主驱动部位传来“咔咔”、“嗡嗡”或沉闷的金属摩擦、撞击等不正常的声音。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1365"
    }
  },
  {
    "n": {
      "identity": 1366,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "组合安装和维护保养",
        "描述": "确保主轴承在制造和组装阶段就得到精确安装，并结合严格的后期维护保养计划。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1366"
    }
  },
  {
    "n": {
      "identity": 1367,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "操作与润滑",
        "描述": "严格遵守操作规程，避免野蛮施工，并确保润滑系统按时、按量、按质地供给润滑剂。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1367"
    }
  },
  {
    "n": {
      "identity": 1368,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "密封检查",
        "描述": "定期检查和维护主轴承的多道密封系统，确保其完好有效，防止任何污染物进入。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1368"
    }
  },
  {
    "n": {
      "identity": 1369,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "控制监测",
        "描述": "利用在线监测系统，对轴承的温度、振动、驱动扭矩等关键参数进行7x24小时不间断的监控和预警。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1369"
    }
  },
  {
    "n": {
      "identity": 1370,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "补充更换润滑油",
        "描述": "根据使用时间和监测结果，定期向轴承腔内补充或全部更换新的润滑油脂。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1370"
    }
  },
  {
    "n": {
      "identity": 1371,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "疏通主轴承润滑孔道",
        "描述": "当发现油脂压力异常时，需要检查并清理从油脂泵到轴承内部的所有管路，确保润滑“生命线”畅通。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1371"
    }
  },
  {
    "n": {
      "identity": 1372,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "调整参数",
        "描述": "在发现异常迹象后，通过适当降低推进速度、刀盘转速等掘进参数来减小主轴承的负荷，以延缓损坏进程。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1372"
    }
  },
  {
    "n": {
      "identity": 1373,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "定期维护",
        "描述": "执行预定的停机检修计划，对轴承及相关系统进行全面的检查、维护和数据分析。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1373"
    }
  },
  {
    "n": {
      "identity": 1374,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "电气系统合理设计",
        "描述": "通过加装绝缘装置或接地碳刷等方式，为杂散电流提供一个旁路通道，避免其穿过轴承。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1374"
    }
  },
  {
    "n": {
      "identity": 1375,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "报废处理",
        "描述": "当监测数据表明轴承已损坏到无法修复或继续使用会带来巨大风险时，必须将其整体更换，旧的做报废处理。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1375"
    }
  },
  {
    "n": {
      "identity": 1376,
      "labels": [
        "现象"
      ],
      "properties": {
        "name": "主轴承直接损坏"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1376"
    }
  },
  {
    "n": {
      "identity": 1377,
      "labels": [
        "现象"
      ],
      "properties": {
        "name": "密封失效引起的轴承损坏"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1377"
    }
  },
  {
    "n": {
      "identity": 1378,
      "labels": [
        "原因"
      ],
      "properties": {
        "解释": "润滑失效会造成的轴承疲劳",
        "name": "润滑失效",
        "普遍性": "润滑失效约占轴承损坏成因的 50%,润滑不良是造成轴承过早损坏的最主要原因。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1378"
    }
  },
  {
    "n": {
      "identity": 1379,
      "labels": [
        "原因"
      ],
      "properties": {
        "解释": "盾构主轴承的不恰当选型、轴承短期严重偏离正常工况工作或长期超负荷运行,都会直接造成轴承失效。",
        "name": "选型不当或荷载过大"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1379"
    }
  },
  {
    "n": {
      "identity": 1380,
      "labels": [
        "原因"
      ],
      "properties": {
        "解释": "微动磨损会造成的轴承套圈破坏",
        "name": "微动磨损",
        "损坏原理": "由于轴承滚道面和滚动体接触面间相对微小滑动而产生的磨损,长期反复小振幅的摇摆运动和过盈量不足形成变色磨痕,轴承套圈破坏最终直接导致主轴承的损坏。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1380"
    }
  },
  {
    "n": {
      "identity": 1381,
      "labels": [
        "原因"
      ],
      "properties": {
        "预防措施": "无法避免。滚动件与滚道接触面的接触应力作用始终存在。",
        "解释": "接触疲劳造成的轴承主要部件失效",
        "name": "接触疲劳",
        "损坏原理": "轴承表面的摩擦损失几乎都变为热量,主要受力件温度上升会造成运转时的冲击荷载、振动和噪声的加剧,叠加积累的接触疲劳大小决定了主轴承的使用寿命。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1381"
    }
  },
  {
    "n": {
      "identity": 1382,
      "labels": [
        "原因"
      ],
      "properties": {
        "name": "主驱动轴承密封失效",
        "损坏原理": "密封一旦失效,泥砂进入轴承会造成主轴承损毁并直接导致盾构无法掘进",
        "密封作用": "阻止盾构主驱动刀盘内的渣土进入主轴承齿轮箱内部和对主驱动轴承回转滑动机构、密封部位以及与泥砂接触的机构进行冲洗和润滑"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1382"
    }
  },
  {
    "n": {
      "identity": 1383,
      "labels": [
        "原因"
      ],
      "properties": {
        "name": "油脂量不足，油脂溢出压力不足",
        "现象": "油脂注入不到位，在高水压下，泥浆通过迷宫密封进入轴承密封，轴承滚子及滚道表面在夹杂硬质小颗粒后出现压痕，焊接刀盘时搭铁线未严格按标准放置，致使主轴承滚子和滚道面接触处有大电流通过产生电熔蚀坑，两者在重载作用下造成了主轴承的逐步损坏。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1383"
    }
  },
  {
    "n": {
      "identity": 1384,
      "labels": [
        "原因"
      ],
      "properties": {
        "name": "水土压力过大，超过油脂阻力",
        "现象": "出现结泥饼、压力不均、局部土压力增大、刀盘处高温、油脂阻力减小等现象，土舱渣土颗粒进入轴承内部,直接导致主轴承密封失效，较短时间内主轴承发生严重损坏。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1384"
    }
  },
  {
    "n": {
      "identity": 1385,
      "labels": [
        "措施"
      ],
      "properties": {
        "选取方式": "主轴承直径不能太小，直径设计应综合考虑负荷承载量；盾构掘进中应控制循环作业时间，盾构推进距离不宜太长，避免或减缓主轴承接触疲劳造成的盾构损坏。 ",
        "name": "组合安装和维护保养"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1385"
    }
  },
