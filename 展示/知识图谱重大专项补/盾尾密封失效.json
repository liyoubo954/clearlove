[
  {
    "n": {
      "identity": 1279,
      "labels": [
        "风险名称"
      ],
      "properties": {
        "name": "盾尾密封失效"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1279"
    }
  },
  {
    "n": {
      "identity": 1280,
      "labels": [
        "原因"
      ],
      "properties": {
        "name": "密封系统设计缺陷",
        "描述": "盾尾密封系统本身的设计存在不足，使其在特定地质或施工条件下难以保证密封效果。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1280"
    }
  },
  {
    "n": {
      "identity": 1281,
      "labels": [
        "原因"
      ],
      "properties": {
        "name": "密封材料老化",
        "描述": "长时间使用后，盾尾刷的钢丝或橡胶等材料会自然变质、变脆或失去弹性，从而导致密封能力下降。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1281"
    }
  },
  {
    "n": {
      "identity": 1282,
      "labels": [
        "原因"
      ],
      "properties": {
        "name": "盾尾刷组装有问题",
        "描述": "在安装盾尾刷时，如果搭接长度不够、固定不牢或顺序错误，就会留下先天的密封缝隙。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1282"
    }
  },
  {
    "n": {
      "identity": 1283,
      "labels": [
        "原因"
      ],
      "properties": {
        "name": "钢板束及止浆板选型问题",
        "描述": "选用的钢板束（构成盾尾刷骨架）或止浆板的规格、材质不符合设计要求或地质条件，导致其无法有效工作。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1283"
    }
  },
  {
    "n": {
      "identity": 1284,
      "labels": [
        "原因"
      ],
      "properties": {
        "name": "密封件变形",
        "描述": "盾尾刷在挤压或碰撞后发生弯曲、扭曲等永久变形，使其无法再与管片表面紧密贴合。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1284"
    }
  },
  {
    "n": {
      "identity": 1285,
      "labels": [
        "原因"
      ],
      "properties": {
        "name": "管片拼装错台",
        "描述": "隧道环向的管片之间或前后环管片之间存在高低不平的台阶，这个台阶会刮伤盾尾刷或形成泄漏通道。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1285"
    }
  },
  {
    "n": {
      "identity": 1286,
      "labels": [
        "原因"
      ],
      "properties": {
        "name": "油脂注入量不足",
        "描述": "盾尾密封油脂未能足量、持续地注入到各道密封刷之间，无法形成有效的油脂密封腔。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1286"
    }
  },
  {
    "n": {
      "identity": 1287,
      "labels": [
        "原因"
      ],
      "properties": {
        "name": "姿态控制不佳",
        "描述": "盾构机掘进时的姿态（如俯仰、偏航）控制不当，导致盾构机轴线与隧道轴线偏离，使盾尾间隙不均匀。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1287"
    }
  },
  {
    "n": {
      "identity": 1288,
      "labels": [
        "现象"
      ],
      "properties": {
        "name": "盾尾未清理",
        "描述": "未能及时清理掉粘附在盾尾密封刷上或其周围的已凝固浆液、渣土等杂物，这些硬化的杂物会像砂纸一样磨损甚至卡坏密封件。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1288"
    }
  },
  {
    "n": {
      "identity": 1289,
      "labels": [
        "现象"
      ],
      "properties": {
        "name": "推进力增加",
        "描述": "浆液或土体进入盾尾间隙，增大了盾构机外壳与管片之间的摩擦力，导致需要更大的推力才能前进。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1289"
    }
  },
  {
    "n": {
      "identity": 1290,
      "labels": [
        "现象"
      ],
      "properties": {
        "name": "推进速度减慢",
        "描述": "由于推进阻力增大或为了处理泄漏问题，盾构机的整体掘进速度被迫放缓。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1290"
    }
  },
  {
    "n": {
      "identity": 1291,
      "labels": [
        "现象"
      ],
      "properties": {
        "name": "刀盘转速改变",
        "描述": "盾尾问题有时会影响整机稳定性，间接导致操作手为调整姿态或应对阻力而改变刀盘的转速。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1291"
    }
  },
  {
    "n": {
      "identity": 1292,
      "labels": [
        "现象"
      ],
      "properties": {
        "name": "俯仰角超限",
        "描述": "盾构机为了克服因盾尾问题引起的姿态偏差，其俯仰角度可能会超出正常控制范围。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1292"
    }
  },
  {
    "n": {
      "identity": 1293,
      "labels": [
        "现象"
      ],
      "properties": {
        "name": "油脂泵压力显示异常低值",
        "描述": "由于密封失效导致油脂大量泄漏，油脂泵无法在密封腔内建立并维持正常的压力。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1293"
    }
  },
  {
    "n": {
      "identity": 1294,
      "labels": [
        "现象"
      ],
      "properties": {
        "name": "油脂压力传感器显示周期性骤降",
        "描述": "压力会随着管片环的拼装或盾构的微小移动而有规律地突然下降，表明在特定位置存在泄漏点。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1294"
    }
  },
  {
    "n": {
      "identity": 1295,
      "labels": [
        "现象"
      ],
      "properties": {
        "name": "注浆流量计与压力计数据不同步",
        "描述": "尽管注浆系统显示仍在泵送浆液，但注浆压力却上不去，说明浆液没有被有效填充到空隙中而是漏掉了。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1295"
    }
  },
  {
    "n": {
      "identity": 1296,
      "labels": [
        "现象"
      ],
      "properties": {
        "name": "土仓压力异常波动",
        "描述": "盾尾的严重泄漏可能破坏整机的压力平衡，进而影响到开挖面的稳定，导致土仓压力出现异常波动。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1296"
    }
  },
  {
    "n": {
      "identity": 1297,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "优化设计",
        "描述": "从根本上改进盾尾密封的结构设计，增强其可靠性和耐久性。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1297"
    }
  },
  {
    "n": {
      "identity": 1298,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "替换密封",
        "描述": "在确认盾尾刷已严重磨损或损坏后，进入盾尾进行人工更换新的密封刷。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1298"
    }
  },
  {
    "n": {
      "identity": 1299,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "盾尾刷核验",
        "描述": "在盾构机始发前或组装时，严格检查盾尾刷的安装质量，确保其符合规范要求。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1299"
    }
  },
  {
    "n": {
      "identity": 1300,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "钢板束焊接质量控制",
        "描述": "确保构成盾尾刷的金属部件焊接牢固，防止在使用中断裂或变形。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1300"
    }
  },
  {
    "n": {
      "identity": 1301,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "盾尾调圆",
        "描述": "如果监测到盾尾壳体因受力不均等原因发生形变（椭圆化），需采取措施进行校正，恢复其圆形。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1301"
    }
  },
  {
    "n": {
      "identity": 1302,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "管片拼装控制",
        "描述": "在拼装隧道管片时严格控制精度，减小环间和块间的错台量。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1302"
    }
  },
  {
    "n": {
      "identity": 1303,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "管片拼装前",
        "描述": "拼装前，仔细清理管片接缝和盾尾刷，移除可能影响密封的杂物。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1303"
    }
  },
  {
    "n": {
      "identity": 1304,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "管片拼装时",
        "描述": "在拼装过程中，小心操作，避免管片角或连接螺栓等部位刮坏盾尾刷。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1304"
    }
  },
  {
    "n": {
      "identity": 1305,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "管片拼装后",
        "描述": "完成一环拼装后，立即检查密封效果，并及时调整盾构姿态。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1305"
    }
  },
  {
    "n": {
      "identity": 1306,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "油脂选择检查",
        "描述": "选择适合地层条件（如水压、温度）的优质盾尾密封油脂，并确保其未变质。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1306"
    }
  },
  {
    "n": {
      "identity": 1307,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "增加注入量",
        "描述": "当发现轻微泄漏时，适当加大盾尾油脂的注入量和频率，尝试重新建立密封腔。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1307"
    }
  },
  {
    "n": {
      "identity": 1308,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "检查油脂注入系统",
        "描述": "检查并确保油脂泵、管路和注入点工作正常，保证油脂能被顺利输送到位。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1308"
    }
  },
  {
    "n": {
      "identity": 1309,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "姿态矫正",
        "描述": "通过精细化操作，及时纠正盾构机的掘进姿态偏差，使盾尾间隙保持均匀。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1309"
    }
  },
  {
    "n": {
      "identity": 1310,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "及时清理",
        "描述": "一旦发生泄漏，应尽快清理漏出的浆液和杂物，防止其凝固后对盾尾刷造成二次损害。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1310"
    }
  },
  {
    "n": {
      "identity": 1311,
      "labels": [
        "原因"
      ],
      "properties": {
        "name": "密封件自身问题"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1311"
    }
  },
  {
    "n": {
      "identity": 1312,
      "labels": [
        "原因"
      ],
      "properties": {
        "name": "现场拼装"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1312"
    }
  },
  {
    "n": {
      "identity": 1313,
      "labels": [
        "原因"
      ],
      "properties": {
        "name": "现场施工"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1313"
    }
  },
  {
    "n": {
      "identity": 1314,
      "labels": [
        "原因"
      ],
      "properties": {
        "盾尾间隙": "盾尾的间隙设计有缺陷，在小转弯隧道施工盾尾左右间隙难以控制，极易出现单侧间隙过小，盾尾刷前部保护板出现磨损或者挤压断裂。",
        "夹层未加固": "未增加肋板进行加固，掘进施工过程中一旦遭遇基岩突起极易出现盾尾变形。",
        "name": "密封系统设计缺陷",
        "油脂注孔": "在设计预埋注浆管路时盾尾油脂注入孔分布不均匀，后期在掘进施工过程中，部分位置油脂注入量过小，盾尾刷磨损。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1314"
    }
  },
  {
    "n": {
      "identity": 1315,
      "labels": [
        "原因"
      ],
      "properties": {
        "解释": "盾尾运输到组装完成一般经过3次以上倒运吊装，组装完成后会发生不同程度的形变。一般盾尾圆度误差允许3cm以内，若形变量过大导致盾尾间隙不均匀会形成盾尾密封薄弱点。",
        "name": "密封件变形"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1315"
    }
  },
  {
    "n": {
      "identity": 1316,
      "labels": [
        "原因"
      ],
      "properties": {
        "解释": "盾尾刷各部分的设计尺寸、基础材质、制作工艺等一项或几项不达要求。",
        "name": "盾尾刷组装"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1316"
    }
  },
  {
    "n": {
      "identity": 1317,
      "labels": [
        "原因"
      ],
      "properties": {
        "解释": "钢板束的厚度及选型不应过薄",
        "name": "钢板束及止浆板选型"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1317"
    }
  },
  {
    "n": {
      "identity": 1318,
      "labels": [
        "原因"
      ],
      "properties": {
        "解释": "管片拼装时不可避免产生错台，导致成环管片的外弧面不平整。这会加剧盾尾刷磨损、变形，出现盾尾渗透现象。",
        "name": "管片拼装错台"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1318"
    }
  },
  {
    "n": {
      "identity": 1319,
      "labels": [
        "原因"
      ],
      "properties": {
        "解释": "油脂注入量较少，就会导致砂浆及外部的泥沙进入油脂腔，影响密封效果，也会对盾尾刷造成磨损。一旦盾尾油脂注入量不足，极易发生大面积的水及泥沙进入盾尾，对盾尾刷造成永久性的损伤。",
        "name": "油脂注入量不足"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1319"
    }
  },
  {
    "n": {
      "identity": 1320,
      "labels": [
        "原因"
      ],
      "properties": {
        "解释": "在小曲率转弯段，大坡度段状况时，若地层中含砂率较高，固结效果差，盾构姿态控制不佳导致盾尾间隙过小，就会对盾构刷造成永久性损坏。",
        "name": "姿态控制不佳"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1320"
    }
  },
  {
    "n": {
      "identity": 1321,
      "labels": [
        "原因"
      ],
      "properties": {
        "解释": "管片拼装过程中，下部的盾尾一般会有一些泥沙等垃圾，在清理不到位会使盾尾的部分泥沙随着推进进入油脂腔，对盾尾刷造成损坏。",
        "name": "盾尾未清理"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1321"
    }
  },
  {
    "n": {
      "identity": 1322,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "优化设计",
        "方式": "充分考虑隧道转弯半径，盾尾间隙控制在65 mm～85 mm，使盾尾油脂注入孔均匀分布于盾尾四周。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1322"
    }
  },
  {
    "n": {
      "identity": 1323,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "盾尾调圆",
        "方式": "拼装完成后，必须进行盾尾圆度测量，必须在误差范围以内才能进行焊接，如果超出误差范围必须进行重新调圆，符合标准后再进行焊接。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1323"
    }
  },
  {
    "n": {
      "identity": 1324,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "盾尾刷核验",
        "方式": "盾尾刷进场后核验其弹性形变、塑性形变的程度，确定其质量优劣情况"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1324"
    }
  },
  {
    "n": {
      "identity": 1325,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "钢板束焊接质量控制",
        "方式": "安装焊接盾尾刷时，每块盾尾刷的钢板向同一方向进行搭接，只保留一个接头，相邻两道盾尾刷的接头远离且避免出现在盾尾底部。尾刷前后满焊，焊脚高度10 mm，确保焊缝整齐，无夹渣、气孔及裂纹。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1325"
    }
  },
  {
    "n": {
      "identity": 1326,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "管片拼装前",
        "方式": "利用压缩空气对管片进行清理，确保密封条附近无污染物。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1326"
    }
  },
  {
    "n": {
      "identity": 1327,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "管片拼装时",
        "方式": "先进行管片粗定位，正在拼装的管片与拼装好的管片之间保留一定的间隙(环向间隙大于3 cm，纵向间隙大于3 cm)，以防调整过程中损坏止水条或磕碰管片。再通过拼装机微调装置来调整已经粗定位的管片进行精确定位。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1327"
    }
  },
  {
    "n": {
      "identity": 1328,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "管片拼装后",
        "方式": "千斤顶完全压紧管片后，使用插片法对管片拼装情况进行测量复核，相邻环的环面间隙每环测6点且≤1mm，纵缝间隙每条缝隙测3点且≤2mm。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1328"
    }
  },
  {
    "n": {
      "identity": 1329,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "姿态矫正",
        "方式": "设定姿态偏差阈值，当盾构姿态超限时，调整分区千斤顶压力来进行纠偏。姿态偏差较小时，不能对姿态进行急纠猛纠，避免出现蛇形曲线。当超限严重时可以采用开启超挖刀、单侧加大注浆量等来进行纠偏。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1329"
    }
  },
  {
    "n": {
      "identity": 1330,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "油脂选择检查",
        "方式": "依据地层条件进行油脂选择。对进场的油脂进行检查，通过泵送性、抗水冲刷性、环保性等试验来选取"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1330"
    }
  },
  {
