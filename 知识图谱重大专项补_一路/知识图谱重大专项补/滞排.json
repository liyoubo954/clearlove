[
  {
    "n": {
      "identity": 1208,
      "labels": [
        "风险名称"
      ],
      "properties": {
        "name": "滞排"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1208"
    }
  },
  {
    "n": {
      "identity": 1209,
      "labels": [
        "原因"
      ],
      "properties": {
        "name": "渣土黏性过大",
        "描述": "开挖的土体黏性非常高时，渣土容易粘附在螺旋输送机上，导致运输困难。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1209"
    }
  },
  {
    "n": {
      "identity": 1210,
      "labels": [
        "原因"
      ],
      "properties": {
        "name": "砂卵石地层",
        "描述": "富含砂卵石的地层中掘进，大颗粒的石块容易卡在螺旋输送机的叶片或排土口处。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1210"
    }
  },
  {
    "n": {
      "identity": 1211,
      "labels": [
        "原因"
      ],
      "properties": {
        "name": "塑性指数低",
        "描述": "塑性指数低的土体（如粉砂）流动性差，难以形成适合螺旋输送的“塑性流”状态。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1211"
    }
  },
  {
    "n": {
      "identity": 1212,
      "labels": [
        "原因"
      ],
      "properties": {
        "name": "大块障碍物",
        "描述": "掘进过程中遇到未预见的大石头、混凝土块等障碍物，会直接卡住输送系统。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1212"
    }
  },
  {
    "n": {
      "identity": 1213,
      "labels": [
        "原因"
      ],
      "properties": {
        "name": "螺旋输送机驱动功率、扭矩不足",
        "描述": "驱动系统的马力或扭矩不够时，无法提供足够的力量来转动和推送高阻力的渣土。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1213"
    }
  },
  {
    "n": {
      "identity": 1214,
      "labels": [
        "原因"
      ],
      "properties": {
        "name": "螺旋输送机设计参数不匹配",
        "描述": "螺旋输送机的设计（如螺距、直径、转速）与实际地质条件不符降低排土效率。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1214"
    }
  },
  {
    "n": {
      "identity": 1215,
      "labels": [
        "原因"
      ],
      "properties": {
        "name": "长时间停机",
        "描述": "长时间停止工作，土仓和螺旋输送机内的渣土会因失水而固结，增加再次启动的难度。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1215"
    }
  },
  {
    "n": {
      "identity": 1216,
      "labels": [
        "原因"
      ],
      "properties": {
        "name": "螺旋输送机叶片或外壳磨损严重，间隙过大",
        "描述": "长期的磨损导致叶片与外壳之间的间隙变大，渣土会在此处“空转”而无法有效前移。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1216"
    }
  },
  {
    "n": {
      "identity": 1217,
      "labels": [
        "原因"
      ],
      "properties": {
        "name": "排土口闸门开启度不足或被卡住",
        "描述": "排土口的闸门没有完全打开或被异物卡住，会直接限制渣土的排出通道。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1217"
    }
  },
  {
    "n": {
      "identity": 1218,
      "labels": [
        "现象"
      ],
      "properties": {
        "name": "改良剂注入孔堵塞",
        "描述": "用于改善土体性质的泡沫剂或膨润土无法有效注入，是排土状况恶化的前兆。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1218"
    }
  },
  {
    "n": {
      "identity": 1219,
      "labels": [
        "现象"
      ],
      "properties": {
        "name": "土仓压力持续升高或剧烈波动",
        "描述": "渣土排不出去，后续进来的土体会不断挤压土仓，导致内部压力异常升高或不稳定。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1219"
    }
  },
  {
    "n": {
      "identity": 1220,
      "labels": [
        "现象"
      ],
      "properties": {
        "name": "螺旋输送机扭矩显著增大",
        "描述": "系统为了排出堵塞的渣土需要花费更大的力气，导致驱动电机的扭矩数值急剧上升。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1220"
    }
  },
  {
    "n": {
      "identity": 1221,
      "labels": [
        "现象"
      ],
      "properties": {
        "name": "排土量明显减少或完全中断",
        "描述": "螺旋输送机出口处的出土量变得很少甚至完全没有。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1221"
    }
  },
  {
    "n": {
      "identity": 1222,
      "labels": [
        "现象"
      ],
      "properties": {
        "name": "掘进速度减慢或停止",
        "描述": "渣土无法排出，为了保证安全，必须降低甚至停止盾构机的掘进。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1222"
    }
  },
  {
    "n": {
      "identity": 1223,
      "labels": [
        "现象"
      ],
      "properties": {
        "name": "渣土温度异常",
        "描述": "渣土在螺旋输送机内因堵塞和摩擦而长时间挤压，会导致其温度异常升高。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1223"
    }
  },
  {
    "n": {
      "identity": 1224,
      "labels": [
        "现象"
      ],
      "properties": {
        "name": "螺旋输送机壳体温度升高",
        "描述": "内部的剧烈摩擦和高负荷运转会产生大量热量，使得螺旋输送机的外部壳体温度也随之升高。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1224"
    }
  },
  {
    "n": {
      "identity": 1225,
      "labels": [
        "现象"
      ],
      "properties": {
        "name": "异常的声响",
        "描述": "设备会发出因过载、摩擦或障碍物卡滞而产生的刺耳、沉闷的异常响声。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1225"
    }
  },
  {
    "n": {
      "identity": 1226,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "注入泡沫剂",
        "描述": "向土仓内注入泡沫剂，以增加渣土的流动性和压缩性，降低其内部摩擦力。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1226"
    }
  },
  {
    "n": {
      "identity": 1227,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "注入改良剂",
        "描述": "根据地质情况注入特定的改良剂（如分散剂、絮凝剂），优化渣土的物理性质。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1227"
    }
  },
  {
    "n": {
      "identity": 1228,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "添加泡沫剂或膨润土",
        "描述": "通过添加泡沫剂来降低黏土的黏性，或通过添加膨润土在砂卵石地层中形成“泥膜”以改善其流动性。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1228"
    }
  },
  {
    "n": {
      "identity": 1229,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "反转排出",
        "描述": "尝试将螺旋输送机短暂反向转动，以松动卡住的障碍物或渣土，然后再正转排出。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1229"
    }
  },
  {
    "n": {
      "identity": 1230,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "停机处理",
        "描述": "在发生严重堵塞时，必须停止掘进，打开排土口或检查口进行人工清理。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1230"
    }
  },
  {
    "n": {
      "identity": 1231,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "优化渣土改良",
        "描述": "根据实时监测的参数（如扭矩、土压）不断调整改良剂的配方和注入量，进行精细化管理。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1231"
    }
  },
  {
    "n": {
      "identity": 1232,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "搅拌棒优化",
        "描述": "优化土仓内搅拌棒的布局和结构，使其能更有效地破碎土块并与改良剂混合。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1232"
    }
  },
  {
    "n": {
      "identity": 1233,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "螺旋机优化",
        "描述": "对螺旋输送机的设计进行改进，例如调整螺距或增加耐磨涂层，以适应特定地层。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1233"
    }
  },
  {
    "n": {
      "identity": 1234,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "提前排空",
        "描述": "在计划停机前，尽量将螺旋输送机和土仓内的渣土排空，防止其固结。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1234"
    }
  },
  {
    "n": {
      "identity": 1235,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "定期转动",
        "描述": "在短时间停机期间，每隔一段时间就让螺旋输送机转动一下，防止渣土板结。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1235"
    }
  },
  {
    "n": {
      "identity": 1236,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "停机检修",
        "描述": "利用停机时间对螺旋输送机的叶片、外壳、驱动系统等进行全面的检查和维修。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1236"
    }
  },
  {
    "n": {
      "identity": 1237,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "检查清理",
        "描述": "打开检查口，直接观察内部情况并清理掉任何可见的障碍物或结块的渣土。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1237"
    }
  },
  {
    "n": {
      "identity": 1238,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "定期冲洗",
        "描述": "在适当的时候（如停机后）使用高压水或泥浆对螺旋输送机内部进行冲洗，清除附着的土体。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1238"
    }
  },
