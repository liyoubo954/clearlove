[
  {
    "n": {
      "identity": 1402,
      "labels": [
        "风险名称"
      ],
      "properties": {
        "name": "刀盘结泥饼"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1402"
    }
  },
  {
    "n": {
      "identity": 1403,
      "labels": [
        "原因"
      ],
      "properties": {
        "name": "黏土地层",
        "描述": "高黏性土层（如膨润土、高岭土）易吸附在金属表面，形成泥饼的基础地质条件。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1403"
    }
  },
  {
    "n": {
      "identity": 1404,
      "labels": [
        "原因"
      ],
      "properties": {
        "name": "含水率高",
        "描述": "土体孔隙水压力大，使黏土颗粒更易黏结，同时降低渣土流动性。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1404"
    }
  },
  {
    "n": {
      "identity": 1405,
      "labels": [
        "原因"
      ],
      "properties": {
        "name": "塑性指数高",
        "描述": "土体塑性强（IP>17），受挤压后易变形黏附，难以破碎排出。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1405"
    }
  },
  {
    "n": {
      "identity": 1406,
      "labels": [
        "原因"
      ],
      "properties": {
        "name": "蒙脱石含量高",
        "描述": "蒙脱石矿物吸水膨胀性强，加剧黏土黏附性和保水性。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1406"
    }
  },
  {
    "n": {
      "identity": 1407,
      "labels": [
        "原因"
      ],
      "properties": {
        "name": "泡沫注入量不足",
        "描述": "泡沫润滑作用未充分发挥，渣土改良效果差。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1407"
    }
  },
  {
    "n": {
      "identity": 1408,
      "labels": [
        "原因"
      ],
      "properties": {
        "name": "泡沫配比不合理",
        "描述": "发泡剂浓度或FIR（膨胀率）不匹配地层，降低泡沫稳定性与润滑性。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1408"
    }
  },
  {
    "n": {
      "identity": 1409,
      "labels": [
        "原因"
      ],
      "properties": {
        "name": "渣土改良剂类型错误",
        "描述": "未针对黏土地层选用抗黏型改良剂（如聚合物）。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1409"
    }
  },
  {
    "n": {
      "identity": 1410,
      "labels": [
        "原因"
      ],
      "properties": {
        "name": "刀盘转速过低",
        "描述": "离心力不足，无法有效甩脱黏土。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1410"
    }
  },
  {
    "n": {
      "identity": 1411,
      "labels": [
        "原因"
      ],
      "properties": {
        "name": "推进速度过快",
        "描述": "排土速率低于掘进速率，导致黏土在刀盘堆积。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1411"
    }
  },
  {
    "n": {
      "identity": 1412,
      "labels": [
        "原因"
      ],
      "properties": {
        "name": "土仓压力过高",
        "描述": "压实效应使黏土密实成块。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1412"
    }
  },
  {
    "n": {
      "identity": 1413,
      "labels": [
        "原因"
      ],
      "properties": {
        "name": "刀盘开口率不足",
        "描述": "设计缺陷导致渣土排出通道狭窄（一般要求>30%）。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1413"
    }
  },
  {
    "n": {
      "identity": 1414,
      "labels": [
        "原因"
      ],
      "properties": {
        "name": "刀具布置不合理",
        "描述": "中心刀具或撕裂刀不足，黏土在低剪切区积聚。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1414"
    }
  },
  {
    "n": {
      "identity": 1415,
      "labels": [
        "原因"
      ],
      "properties": {
        "name": "螺旋输送机磨损",
        "描述": "叶片间隙增大或内壁粗糙，排土效率下降。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1415"
    }
  },
  {
    "n": {
      "identity": 1416,
      "labels": [
        "原因"
      ],
      "properties": {
        "name": "停机时间过长",
        "描述": "静态环境下黏土失水硬化。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1416"
    }
  },
  {
    "n": {
      "identity": 1417,
      "labels": [
        "原因"
      ],
      "properties": {
        "name": "冷却系统不足",
        "描述": "刀盘高温加速黏土脱水固结。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1417"
    }
  },
  {
    "n": {
      "identity": 1418,
      "labels": [
        "原因"
      ],
      "properties": {
        "name": "配备了较大尺寸的限径肋板",
        "描述": "结构件阻碍渣土流动，形成滞留区。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1418"
    }
  },
  {
    "n": {
      "identity": 1419,
      "labels": [
        "原因"
      ],
      "properties": {
        "name": "中心冲刷能力弱",
        "描述": "刀盘中心部位渣土无法有效排出。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1419"
    }
  },
  {
    "n": {
      "identity": 1420,
      "labels": [
        "原因"
      ],
      "properties": {
        "name": "推进油缸推力大为增加",
        "描述": "刀盘结泥饼后切削阻力增大，需更大推力维持掘进，可能引发油缸过载或结构件疲劳。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1420"
    }
  },
  {
    "n": {
      "identity": 1421,
      "labels": [
        "原因"
      ],
      "properties": {
        "name": "刀盘驱动力矩经常维持在额定扭矩",
        "描述": "扭矩持续接近设计最大值。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1421"
    }
  },
  {
    "n": {
      "identity": 1422,
      "labels": [
        "原因"
      ],
      "properties": {
        "name": "刀盘中心体温升加快甚至达到高温",
        "描述": "红外监测显示中心温度从常温骤升至80℃以上。中心区渣土滞留摩擦生热+冷却不足，高温进一步硬化泥饼。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1422"
    }
  },
  {
    "n": {
      "identity": 1423,
      "labels": [
        "原因"
      ],
      "properties": {
        "name": "刀盘贯入度大为减少",
        "描述": "每转切削深度下降50%以上，掘进效率降低，单位进尺能耗增加。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1423"
    }
  },
  {
    "n": {
      "identity": 1424,
      "labels": [
        "原因"
      ],
      "properties": {
        "name": "掘进速度降低",
        "描述": "推进速度下降30%-70%，导致延长工期，增加刀盘暴露于黏土地层的时间。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1424"
    }
  },
  {
    "n": {
      "identity": 1425,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "注入膨润土改良渣土流动性",
        "描述": "优先选用钠基膨润土（膨胀倍率≥5），通过注浆管路与刀盘同步注入。掺量3%-8%干土重量，浆液比重1.05-1.15g/cm³。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1425"
    }
  },
  {
    "n": {
      "identity": 1426,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "增加泡沫剂注入比例降低黏性",
        "描述": "采用抗黏型发泡剂（含硅氧烷成分），通过双泵系统保证注入连续性，泡沫注入比FIR 10-15倍，发泡剂浓度2%-3%。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1426"
    }
  },
  {
    "n": {
      "identity": 1427,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "采用聚合物添加剂抑制黏土水化",
        "描述": "选择阴离子型聚合物（如HPAM），抑制蒙脱石水化，添加量0.2%-0.5%土体重，需与泡沫复配使用。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1427"
    }
  },
  {
    "n": {
      "identity": 1428,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "动态调整泡沫流量与FIR（膨胀率）",
        "描述": "根据扭矩变化实时调节：扭矩上升时增加气液比（如从1:10调至1:15），气流量30-50m³/h，液体流量2-5m³/h。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1428"
    }
  },
  {
    "n": {
      "identity": 1429,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "优化发泡剂浓度（如1.5%~3%）",
        "描述": "通过泡沫系统流量计实时调整发泡剂原液注入量，配合FIR（膨胀率）检测仪动态校准。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1429"
    }
  },
  {
    "n": {
      "identity": 1430,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "更换为复合型泡沫（含抗黏成分）",
        "描述": "采用双组分发泡系统，A组分（常规发泡剂）与B组分（抗黏添加剂）按9:1混合。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1430"
    }
  },
  {
    "n": {
      "identity": 1431,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "提高转速增强切削破碎效果",
        "描述": "需监控扭矩不超过额定值80%，避免电机过载。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1431"
    }
  },
  {
    "n": {
      "identity": 1432,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "降低推进速度匹配排土能力",
        "描述": "匹配原则​​，推进速度（mm/min）≤螺旋机排土能力（m³/h）×60/刀盘开挖面积（㎡）。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1432"
    }
  },
  {
    "n": {
      "identity": 1433,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "降低土压并加强螺旋机排土效率",
        "描述": "同步监测地表沉降，单次调整幅度不超过0.2bar。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1433"
    }
  },
  {
    "n": {
      "identity": 1434,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "设计阶段优化开口率",
        "描述": "将原有30%开口率提升至40%，并在中心区增设200mm×300mm的辅助排渣孔。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1434"
    }
  },
  {
    "n": {
      "identity": 1435,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "拆除过密的固定刮刀",
        "描述": "保留刀具间距≥150mm，优先拆除非承力区的刮刀。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1435"
    }
  },
  {
    "n": {
      "identity": 1436,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "增加撕裂刀或中心刀比例",
        "描述": "中心区撕裂刀占比≥30%，刀具高度差保持50~80mm以增强剪切。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1436"
    }
  },
  {
    "n": {
      "identity": 1437,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "更换螺旋叶片或修复内壁光滑度",
        "描述": "叶片磨损量＞10mm时需堆焊碳化钨（硬度≥HRC60）；内壁抛光至粗糙度Ra≤3.2μm（原Ra通常为6.3~12.5μm）"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1437"
    }
  },
  {
    "n": {
      "identity": 1438,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "修复内壁光滑度",
        "描述": "用金刚石磨头对螺旋机内壁进行镜面加工（粗糙度Ra≤1.6μm）；喷涂聚氨酯-陶瓷复合涂层（厚度0.5mm，摩擦系数＜0.1）"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1438"
    }
  },
  {
    "n": {
      "identity": 1439,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "堆焊耐磨涂层延长寿命",
        "描述": "等离子弧堆焊优于手工电弧焊，涂层厚度2~3mm，耐磨性提高5~8倍。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1439"
    }
  },
  {
    "n": {
      "identity": 1440,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "停机时保持刀盘间歇转动防止黏土沉积",
        "描述": "每停机2小时转动刀盘15分钟，转速0.5rpm，正反转交替进行。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1440"
    }
  },
  {
    "n": {
      "identity": 1441,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "增设刀盘内部冷却喷淋系统",
        "描述": "刀盘驱动轴后端，旋转接头，耐压≥1MPa，流量30L/min；每辐条布置2个喷嘴，扇形喷嘴，孔径3mm；闭式循环系统加入冷却液，5%乙二醇水溶液。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1441"
    }
  },
  {
    "n": {
      "identity": 1442,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "割除不受力的限径肋板",
        "描述": "识别应力＜5MPa的非承力肋板（红色标记区域），保留20mm根部防断裂，切口打磨圆角R≥10mm，刀盘转速升至1.2倍工作转速验证振动值（≤2.5mm/s），每次切割不超过3块肋板，间隔72小时观察扭矩变化。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1442"
    }
  },
  {
    "n": {
      "identity": 1443,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "改进中心冲刷采用分臂分时方式",
        "描述": "将刀盘中心冲刷系统分为3~4组喷嘴，每组独立控制，采用“工作10分钟-停歇5分钟”的循环模式。通过PLC编程实现自动切换，优先启动靠近泥饼积聚区的喷嘴组，冲刷水压维持在4~6MPa。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1443"
    }
  },
  {
    "n": {
      "identity": 1444,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "高压进仓，清除已板结了的泥饼",
        "描述": "首先建立3bar气压平衡掌子面，作业人员经气闸舱减压训练后，佩戴正压呼吸器进入土仓。使用风镐（冲击能量≥60J）破碎泥饼，配合高压水枪（压力≥20MPa）冲洗残留黏土，清除范围覆盖刀盘中心2m半径区域。单次作业限时2小时，完成后需检查刀具磨损情况。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1444"
    }
  },
  {
    "n": {
      "identity": 1445,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "同步注浆封闭掌子面减少渗水",
        "描述": "在掘进同时通过超前注浆管注入速凝浆液（水泥:膨润土:水玻璃=7:2:1），注浆压力为1.2倍水土压力。注浆孔沿刀盘外周每30°布置一个，浆液扩散半径控制在1.5m内，初凝时间≤20分钟，形成止水帷幕减少地下水渗入。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1445"
    }
  },
  {
    "n": {
      "identity": 1446,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "增设备用泡沫发生器避免中断",
        "描述": "在主泡沫发生器旁并联安装备用机组，两套系统共用发泡剂储罐但独立控制。当主系统故障或压力下降10%时，电磁阀在30秒内自动切换至备用管路，维持泡沫注入量稳定（流量波动≤5%）。备用系统每周需空载测试1次。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1446"
    }
  },
  {
    "n": {
      "identity": 1447,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "开启备用排土闸门增加泄压通道",
        "描述": "在螺旋输送机出口侧方增设液压快开式闸门（泄压面积≥0.5m²）。当土仓压力超过设定值0.3MPa时，中控室远程开启闸门泄压，同时降低螺旋机转速防止喷涌。泄压后需立即关闭闸门并检查渣土性状。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1447"
    }
  },
  {
    "n": {
      "identity": 1448,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "注入压缩空气平衡压力",
        "描述": "通过土仓顶部进气阀注入干燥压缩空气，气压控制在0.1~0.15倍土压（最高不超过0.3MPa）。注气时同步降低螺旋机转速至正常值的70%，持续30分钟后逐渐泄压。注气前后需监测土仓内氧气含量（＞19.5%）。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1448"
    }
  },
  {
    "n": {
      "identity": 1449,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "停机前注入防腐隔离剂防止黏土硬化",
        "描述": "停机前2小时通过刀盘注入口泵入油性隔离剂（矿物油基+有机胺），用量按刀盘表面积×0.1L/m²计算。注入后保持刀盘低速转动（0.2rpm）10分钟使药剂均匀覆盖。重启设备时需先空转5分钟清除残留剂。
"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1449"
    }
  },
  {
    "n": {
      "identity": 1450,
      "labels": [
        "措施"
      ],
      "properties": {
        "name": "优化冷却水管布局",
        "描述": "将原直列式水管改为螺旋盘管布局，管间距从150mm缩小至80mm，增加换热面积50%。冷却水流量提升至15m³/h，进水温度≤25℃。改造后需进行压力测试（1.5倍工作压力保压30分钟无泄漏）。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1450"
    }
  },
