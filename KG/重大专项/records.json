      ],
      "properties": {
        "name": "推进速度过快",
        "表现": "排土速率低于掘进速率，导致黏土在刀盘堆积。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:9"
    }
  },
  {
    "n": {
      "identity": 10,
      "labels": [
        "Entity",
        "参数原因"
      ],
      "properties": {
        "name": "土仓压力过高",
        "表现": "压实效应使黏土密实成块。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:10"
    }
  },
  {
    "n": {
      "identity": 11,
      "labels": [
        "Entity",
        "设计缺陷"
      ],
      "properties": {
        "name": "刀盘开口率不足",
        "描述": "设计缺陷导致渣土排出通道狭窄（一般要求>30%）。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:11"
    }
  },
  {
    "n": {
      "identity": 12,
      "labels": [
        "Entity",
        "设计缺陷"
      ],
      "properties": {
        "name": "刀具布置不合理",
        "描述": "中心刀具或撕裂刀不足，黏土在低剪切区积聚。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:12"
    }
  },
  {
    "n": {
      "identity": 13,
      "labels": [
        "Entity",
        "设计缺陷"
      ],
      "properties": {
        "name": "螺旋输送机磨损",
        "描述": "叶片间隙增大或内壁粗糙，排土效率下降。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:13"
    }
  },
  {
    "n": {
      "identity": 14,
      "labels": [
        "Entity",
        "参数原因"
      ],
      "properties": {
        "name": "停机时间过长",
        "描述": "静态环境下黏土失水硬化。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:14"
    }
  },
  {
    "n": {
      "identity": 15,
      "labels": [
        "Entity",
        "设计缺陷"
      ],
      "properties": {
        "name": "冷却系统不足",
        "描述": "刀盘高温加速黏土脱水固结。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:15"
    }
  },
  {
    "n": {
      "identity": 16,
      "labels": [
        "Entity",
        "设计缺陷"
      ],
      "properties": {
        "name": "配备了较大尺寸的限径肋板",
        "描述": "结构件阻碍渣土流动，形成滞留区。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:16"
    }
  },
  {
    "n": {
      "identity": 17,
      "labels": [
        "Entity",
        "设计缺陷"
      ],
      "properties": {
        "name": "中心冲刷能力弱",
        "描述": "刀盘中心部位渣土无法有效排出。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:17"
    }
  },
  {
    "n": {
      "identity": 18,
      "labels": [
        "Entity",
        "参数原因"
      ],
      "properties": {
        "name": "推进油缸推力大为增加",
        "表现": "刀盘结泥饼后切削阻力增大，需更大推力维持掘进，可能引发油缸过载或结构件疲劳。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:18"
    }
  },
  {
    "n": {
      "identity": 19,
      "labels": [
        "Entity",
        "参数原因"
      ],
      "properties": {
        "name": "刀盘驱动力矩经常维持在额定扭矩",
        "表现": "扭矩持续接近设计最大值。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:19"
    }
  },
  {
    "n": {
      "identity": 20,
      "labels": [
        "Entity",
        "参数原因"
      ],
      "properties": {
        "name": "刀盘中心体温升加快甚至达到高温",
        "表现": "红外监测显示中心温度从常温骤升至80℃以上。中心区渣土滞留摩擦生热+冷却不足，高温进一步硬化泥饼。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:20"
    }
  },
  {
    "n": {
      "identity": 21,
      "labels": [
        "Entity",
        "参数原因"
      ],
      "properties": {
        "表现": "每转切削深度下降50%以上，掘进效率降低，单位进尺能耗增加。",
        "name": "刀盘贯入度大为减少"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:21"
    }
  },
  {
    "n": {
      "identity": 22,
      "labels": [
        "Entity",
        "参数原因"
      ],
      "properties": {
        "name": "掘进速度降低",
        "表现": "推进速度下降30%-70%，导致延长工期，增加刀盘暴露于黏土地层的时间。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:22"
    }
  },
  {
    "n": {
      "identity": 23,
      "labels": [
        "Entity",
        "措施"
      ],
      "properties": {
        "方法": "优先选用钠基膨润土（膨胀倍率≥5），通过注浆管路与刀盘同步注入。掺量3%-8%干土重量，浆液比重1.05-1.15g/cm³。",
        "name": "注入膨润土改良渣土流动性"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:23"
    }
  },
  {
    "n": {
      "identity": 24,
      "labels": [
        "Entity",
        "措施"
      ],
      "properties": {
        "方法": "采用抗黏型发泡剂（含硅氧烷成分），通过双泵系统保证注入连续性，泡沫注入比FIR 10-15倍，发泡剂浓度2%-3%。",
        "name": "增加泡沫剂注入比例降低黏性"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:24"
    }
  },
  {
    "n": {
      "identity": 25,
      "labels": [
        "Entity",
        "措施"
      ],
      "properties": {
        "方法": "选择阴离子型聚合物（如HPAM），抑制蒙脱石水化，添加量0.2%-0.5%土体重，需与泡沫复配使用。",
        "name": "采用聚合物添加剂抑制黏土水化"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:25"
    }
  },
  {
    "n": {
      "identity": 26,
      "labels": [
        "Entity",
        "措施"
      ],
      "properties": {
        "方法": "根据扭矩变化实时调节：扭矩上升时增加气液比（如从1:10调至1:15），气流量30-50m³/h，液体流量2-5m³/h。",
        "name": "动态调整泡沫流量与FIR（膨胀率）"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:26"
    }
  },
  {
    "n": {
      "identity": 27,
      "labels": [
        "Entity",
        "措施"
      ],
      "properties": {
        "方法": "通过泡沫系统流量计实时调整发泡剂原液注入量，配合FIR（膨胀率）检测仪动态校准。",
        "name": "优化发泡剂浓度（如1.5%~3%）"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:27"
    }
  },
  {
    "n": {
      "identity": 28,
      "labels": [
        "Entity",
        "措施"
      ],
      "properties": {
        "方法": "采用双组分发泡系统，A组分（常规发泡剂）与B组分（抗黏添加剂）按9:1混合。",
        "name": "更换为复合型泡沫（含抗黏成分）"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:28"
    }
  },
  {
    "n": {
      "identity": 29,
      "labels": [
        "Entity",
        "措施"
      ],
      "properties": {
        "方法": "需监控扭矩不超过额定值80%，避免电机过载。",
        "name": "提高转速增强切削破碎效果"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:29"
    }
  },
  {
    "n": {
      "identity": 30,
      "labels": [
        "Entity",
        "措施"
      ],
      "properties": {
        "方法": "匹配原则​​，推进速度（mm/min）≤螺旋机排土能力（m³/h）×60/刀盘开挖面积（㎡）。",
        "name": "降低推进速度匹配排土能力"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:30"
    }
  },
  {
    "n": {
      "identity": 31,
      "labels": [
        "Entity",
        "措施"
      ],
      "properties": {
        "方法": "同步监测地表沉降，单次调整幅度不超过0.2bar。",
        "name": "降低土压并加强螺旋机排土效率"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:31"
    }
  },
  {
    "n": {
      "identity": 32,
      "labels": [
        "Entity",
        "措施"
      ],
      "properties": {
        "方法": "将原有30%开口率提升至40%，并在中心区增设200mm×300mm的辅助排渣孔。",
        "name": "设计阶段优化开口率"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:32"
    }
  },
  {
    "n": {
      "identity": 33,
      "labels": [
        "Entity",
        "措施"
      ],
      "properties": {
        "方法": "保留刀具间距≥150mm，优先拆除非承力区的刮刀。",
        "name": "拆除过密的固定刮刀"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:33"
    }
  },
  {
    "n": {
      "identity": 34,
      "labels": [
        "Entity",
        "措施"
      ],
      "properties": {
        "方法": "中心区撕裂刀占比≥30%，刀具高度差保持50~80mm以增强剪切。",
        "name": "增加撕裂刀或中心刀比例"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:34"
    }
  },
  {
    "n": {
      "identity": 35,
      "labels": [
        "Entity",
        "措施"
      ],
      "properties": {
        "方法": "叶片磨损量＞10mm时需堆焊碳化钨（硬度≥HRC60）；内壁抛光至粗糙度Ra≤3.2μm（原Ra通常为6.3~12.5μm）",
        "name": "更换螺旋叶片或修复内壁光滑度"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:35"
    }
  },
  {
    "n": {
      "identity": 36,
      "labels": [
        "Entity",
        "措施"
      ],
      "properties": {
        "方法": "用金刚石磨头对螺旋机内壁进行镜面加工（粗糙度Ra≤1.6μm）；喷涂聚氨酯-陶瓷复合涂层（厚度0.5mm，摩擦系数＜0.1）",
        "name": "修复内壁光滑度"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:36"
    }
  },
  {
    "n": {
      "identity": 37,
      "labels": [
        "Entity",
        "措施"
      ],
      "properties": {
        "方法": "等离子弧堆焊优于手工电弧焊，涂层厚度2~3mm，耐磨性提高5~8倍。",
        "name": "堆焊耐磨涂层延长寿命"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:37"
    }
  },
  {
    "n": {
      "identity": 38,
      "labels": [
        "Entity",
        "措施"
      ],
      "properties": {
        "方法": "每停机2小时转动刀盘15分钟，转速0.5rpm，正反转交替进行。",
        "name": "停机时保持刀盘间歇转动防止黏土沉积"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:38"
    }
  },
  {
    "n": {
      "identity": 39,
      "labels": [
        "Entity",
        "措施"
      ],
      "properties": {
        "方法": "刀盘驱动轴后端，旋转接头，耐压≥1MPa，流量30L/min；每辐条布置2个喷嘴，扇形喷嘴，孔径3mm；闭式循环系统加入冷却液，5%乙二醇水溶液。",
        "name": "增设刀盘内部冷却喷淋系统"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:39"
    }
  },
  {
    "n": {
      "identity": 40,
      "labels": [
        "Entity",
        "措施"
      ],
      "properties": {
        "方法": "识别应力＜5MPa的非承力肋板（红色标记区域），保留20mm根部防断裂，切口打磨圆角R≥10mm，刀盘转速升至1.2倍工作转速验证振动值（≤2.5mm/s），每次切割不超过3块肋板，间隔72小时观察扭矩变化。",
        "name": "割除不受力的限径肋板"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:40"
    }
  },
  {
    "n": {
      "identity": 41,
      "labels": [
        "Entity",
        "措施"
      ],
      "properties": {
        "方法": "将刀盘中心冲刷系统分为3~4组喷嘴，每组独立控制，采用“工作10分钟-停歇5分钟”的循环模式。通过PLC编程实现自动切换，优先启动靠近泥饼积聚区的喷嘴组，冲刷水压维持在4~6MPa。",
        "name": "改进中心冲刷采用分臂分时方式"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:41"
    }
  },
  {
    "n": {
      "identity": 42,
      "labels": [
        "Entity",
        "措施"
      ],
      "properties": {
        "方法": "首先建立3bar气压平衡掌子面，作业人员经气闸舱减压训练后，佩戴正压呼吸器进入土仓。使用风镐（冲击能量≥60J）破碎泥饼，配合高压水枪（压力≥20MPa）冲洗残留黏土，清除范围覆盖刀盘中心2m半径区域。单次作业限时2小时，完成后需检查刀具磨损情况。",
        "name": "高压进仓，清除已板结了的泥饼"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:42"
    }
  },
  {
    "n": {
      "identity": 43,
      "labels": [
        "Entity",
        "措施"
      ],
      "properties": {
        "方法": "在掘进同时通过超前注浆管注入速凝浆液（水泥:膨润土:水玻璃=7:2:1），注浆压力为1.2倍水土压力。注浆孔沿刀盘外周每30°布置一个，浆液扩散半径控制在1.5m内，初凝时间≤20分钟，形成止水帷幕减少地下水渗入。",
        "name": "同步注浆封闭掌子面减少渗水"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:43"
    }
  },
  {
    "n": {
      "identity": 44,
      "labels": [
        "Entity",
        "措施"
      ],
      "properties": {
        "方法": "在主泡沫发生器旁并联安装备用机组，两套系统共用发泡剂储罐但独立控制。当主系统故障或压力下降10%时，电磁阀在30秒内自动切换至备用管路，维持泡沫注入量稳定（流量波动≤5%）。备用系统每周需空载测试1次。",
        "name": "增设备用泡沫发生器避免中断"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:44"
    }
  },
  {
    "n": {
      "identity": 45,
      "labels": [
        "Entity",
        "措施"
      ],
      "properties": {
        "方法": "在螺旋输送机出口侧方增设液压快开式闸门（泄压面积≥0.5m²）。当土仓压力超过设定值0.3MPa时，中控室远程开启闸门泄压，同时降低螺旋机转速防止喷涌。泄压后需立即关闭闸门并检查渣土性状。",
        "name": "开启备用排土闸门增加泄压通道"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:45"
    }
  },
  {
    "n": {
      "identity": 46,
      "labels": [
        "Entity",
        "措施"
      ],
      "properties": {
        "方法": "通过土仓顶部进气阀注入干燥压缩空气，气压控制在0.1~0.15倍土压（最高不超过0.3MPa）。注气时同步降低螺旋机转速至正常值的70%，持续30分钟后逐渐泄压。注气前后需监测土仓内氧气含量（＞19.5%）。",
        "name": "注入压缩空气平衡压力"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:46"
    }
  },
  {
    "n": {
      "identity": 47,
      "labels": [
        "Entity",
        "措施"
      ],
      "properties": {
        "方法": "停机前2小时通过刀盘注入口泵入油性隔离剂（矿物油基+有机胺），用量按刀盘表面积×0.1L/m²计算。注入后保持刀盘低速转动（0.2rpm）10分钟使药剂均匀覆盖。重启设备时需先空转5分钟清除残留剂。",
        "name": "停机前注入防腐隔离剂防止黏土硬化"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:47"
    }
  },
  {
    "n": {
      "identity": 48,
      "labels": [
        "Entity",
        "措施"
      ],
      "properties": {
        "方法": "将原直列式水管改为螺旋盘管布局，管间距从150mm缩小至80mm，增加换热面积50%。冷却水流量提升至15m³/h，进水温度≤25℃。改造后需进行压力测试（1.5倍工作压力保压30分钟无泄漏）。",
        "name": "优化冷却水管布局"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:48"
    }
  },
