      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:235"
    }
  },
  {
    "n": {
      "identity": 236,
      "labels": [
        "Entity",
        "现象"
      ],
      "properties": {
        "name": "油脂泵压力显示异常低值",
