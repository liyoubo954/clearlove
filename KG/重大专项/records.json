      "labels": [
        "Entity",
        "措施"
      ],
      "properties": {
        "方法": "一旦发生泄漏，应尽快清理漏出的浆液和杂物，防止其凝固后对盾尾刷造成二次损害。",
        "name": "及时清理"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:253"
    }
