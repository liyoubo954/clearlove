      "identity": 231,
      "labels": [
        "Entity",
        "现象"
      ],
      "properties": {
        "name": "盾尾未清理",
        "描述": "未能及时清理掉粘附在盾尾密封刷上或其周围的已凝固浆液、渣土等杂物，这些硬化的杂物会像砂纸一样磨损甚至卡坏密封件。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:231"
    }
