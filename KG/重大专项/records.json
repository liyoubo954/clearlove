      "labels": [
        "Entity",
        "风险名称"
      ],
      "properties": {
        "name": "刀盘结泥饼",
        "描述": "盾构机刀盘及刀具表面黏附大量黏土形成硬质泥块的现象，导致切削效率下降、扭矩升高，严重时引发设备过载或停机。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:0"
    }
  },
  {
    "n": {
      "identity": 1,
      "labels": [
        "Entity",
        "地质原因"
      ],
      "properties": {
        "name": "黏土地层",
        "描述": "高黏性土层（如膨润土、高岭土）易吸附在金属表面，形成泥饼的基础地质条件。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:1"
    }
  },
  {
    "n": {
      "identity": 2,
      "labels": [
        "Entity",
        "地质原因"
      ],
      "properties": {
        "name": "含水率高",
        "描述": "土体孔隙水压力大，使黏土颗粒更易黏结，同时降低渣土流动性。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:2"
    }
  },
  {
    "n": {
      "identity": 3,
      "labels": [
        "Entity",
        "地质原因"
      ],
      "properties": {
        "name": "塑性指数高",
        "描述": "土体塑性强（IP>17），受挤压后易变形黏附，难以破碎排出。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:3"
    }
  },
  {
    "n": {
      "identity": 4,
      "labels": [
        "Entity",
        "地质原因"
      ],
      "properties": {
        "name": "蒙脱石含量高",
        "描述": "蒙脱石矿物吸水膨胀性强，加剧黏土黏附性和保水性。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:4"
    }
  },
  {
