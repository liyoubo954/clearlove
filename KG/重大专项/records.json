      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:263"
    }
  },
  {
    "n": {
      "identity": 264,
      "labels": [
        "Entity",
        "设计缺陷"
      ],
      "properties": {
        "name": "严重损坏",
        "描述": "初期的微小损伤未能得到控制，持续发展累积，最终演变为断裂、卡死等不可逆的严重故障状态。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:264"
    }
  },
  {
    "n": {
      "identity": 265,
      "labels": [
        "Entity",
        "参数原因"
      ],
      "properties": {
        "name": "超使用寿命",
