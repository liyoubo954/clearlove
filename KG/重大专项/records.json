      "identity": 252,
      "labels": [
        "Entity",
        "措施"
      ],
      "properties": {
        "方法": "通过精细化操作，及时纠正盾构机的掘进姿态偏差，使盾尾间隙保持均匀。",
        "name": "姿态矫正"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:252"
