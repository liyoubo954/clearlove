      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:229"
    }
  },
  {
    "n": {
      "identity": 230,
      "labels": [
        "Entity",
        "参数原因"
      ],
      "properties": {
        "name": "姿态控制不佳",
        "表现": "盾构机掘进时的姿态（如俯仰、偏航）控制不当，导致盾构机轴线与隧道轴线偏离，使盾尾间隙不均匀。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:230"
    }
  },
  {
