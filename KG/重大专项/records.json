    "n": {
      "identity": 229,
      "labels": [
        "Entity",
        "参数原因"
      ],
      "properties": {
        "表现": "盾尾密封油脂未能足量、持续地注入到各道密封刷之间，无法形成有效的油脂密封腔。",
        "name": "油脂注入量不足"
