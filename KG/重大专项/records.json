      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:265"
    }
  },
  {
    "n": {
      "identity": 266,
      "labels": [
        "Entity",
        "现象"
      ],
      "properties": {
        "name": "推进力异常",
