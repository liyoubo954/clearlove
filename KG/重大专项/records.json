      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:262"
    }
  },
  {
    "n": {
      "identity": 263,
      "labels": [
        "Entity",
        "设计缺陷"
      ],
      "properties": {
        "name": "电流通过轴承",
