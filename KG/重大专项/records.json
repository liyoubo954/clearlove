      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:232"
    }
  },
  {
    "n": {
      "identity": 233,
      "labels": [
        "Entity",
        "现象"
      ],
      "properties": {
        "name": "推进速度减慢",
        "描述": "由于推进阻力增大或为了处理泄漏问题，盾构机的整体掘进速度被迫放缓。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:233"
    }
  },
  {
    "n": {
      "identity": 234,
      "labels": [
        "Entity",
        "现象"
      ],
      "properties": {
