    }
  },
  {
    "n": {
      "identity": 249,
      "labels": [
        "Entity",
        "措施"
      ],
      "properties": {
        "方法": "选择适合地层条件（如水压、温度）的优质盾尾密封油脂，并确保其未变质。",
