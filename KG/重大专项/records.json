      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:266"
    }
  },
  {
    "n": {
      "identity": 267,
      "labels": [
        "Entity",
        "现象"
      ],
      "properties": {
        "name": "扭矩异常",
        "描述": "驱动刀盘旋转所需的扭矩值持续偏高、剧烈波动或突然增大。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:267"
    }
  },
  {
    "n": {
      "identity": 268,
      "labels": [
        "Entity",
        "现象"
      ],
      "properties": {
        "name": "推进速度下降",
        "描述": "由于旋转受阻和扭矩异常，为保护设备，操作手不得不降低掘进速度。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:268"
    }
  },
