      "labels": [
        "Entity",
        "设计缺陷"
      ],
      "properties": {
        "name": "管片拼装错台",
        "描述": "隧道环向的管片之间或前后环管片之间存在高低不平的台阶，这个台阶会刮伤盾尾刷或形成泄漏通道。"
      },
      "elementId": "4:20c054e7-3aea-464a-8411-52b71cd5c7b9:228"
