      "identity": 255,
      "labels": [
        "Entity",
        "设计缺陷"
      ],
      "properties": {
        "name": "选型不当或荷载过大",
        "描述": "选用的主轴承型号无法满足实际地质条件下的载荷要求，或掘进中长期超负荷运转。"
